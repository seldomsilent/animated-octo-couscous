# Database
DATABASE_URL="postgresql://user:password@localhost:5432/receiptflash?schema=public"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# QuickBooks Online Integration
QBO_CLIENT_ID="your-quickbooks-client-id"
QBO_CLIENT_SECRET="your-quickbooks-client-secret"
QBO_REDIRECT_URI="http://localhost:3000/api/auth/qbo/callback"
QBO_ENVIRONMENT="sandbox" # sandbox or production

# OpenAI API (for classification)
OPENAI_API_KEY="your-openai-api-key"

# Google Cloud Vision (for OCR)
GOOGLE_CLOUD_PROJECT_ID="your-project-id"
GOOGLE_APPLICATION_CREDENTIALS="./path-to-service-account.json"

# File Storage (AWS S3 or compatible)
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_REGION="us-west-2"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY="your-deepgram-api-key"
